{
  "name": "@ibisllc/maintainers",
  "version": "0.1.0",
  "type": "module",
  "description": "Pin-a-mandate, verify-forward trust protocol: declare, renew, and transfer signing authority over a versioned artifact. The bake is the ceremony.",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibisllc/maintainers.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/ibisllc/maintainers/tree/main/packages/protocol#readme",
  "bugs": "https://github.com/ibisllc/maintainers/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@maintainers/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "conformance"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --dir tests",
    "prepack": "tsc -b && node scripts/bundle-portable-artifact.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^1.5.0"
  }
}
