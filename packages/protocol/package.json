{
  "name": "@ibisllc/maintainers",
  "version": "0.1.0",
  "type": "module",
  "description": "Pin-a-mandate, verify-forward trust protocol: declare, renew, and transfer signing authority over a versioned artifact. The bake is the ceremony.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@maintainers/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "conformance"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --dir tests",
    "prepack": "tsc -b && node scripts/bundle-portable-artifact.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^1.5.0"
  }
